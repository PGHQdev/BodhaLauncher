<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- User grants this in system settings; screen-time context is absent until then. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Runtime permission, asked only through the education flow (#159); Today reads live, stores nothing. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Runtime permission, asked only through the education flow (#186); Search reads live, stores nothing. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- ADR 0002: app discovery via a scoped queries filter, never QUERY_ALL_PACKAGES -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- ADR 0009: session data never leaves the phone — no Auto Backup either -->
    <application
        android:name=".BodhaApp"
        android:allowBackup="false"
        android:label="Bodha"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- uiMode is handled rather than restarted (#141): the theme is a
             composition-local read, so Compose repaints in place, and a system
             theme change made while Settings is open lands there instead of
             recreating the activity and putting the user back on root. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Declared but inert until the user grants access through the education
             flow (#161); the system binds it only after the grant. -->
        <service
            android:name=".inbox.BodhaNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
